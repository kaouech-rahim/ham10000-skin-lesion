# Données et artefacts : versionnés par DVC, jamais par Git
/data/raw/*
/data/processed/*
!/data/**/.gitkeep
!/data/processed/stats.json
/models/*
!/models/.gitkeep
!/models/metadata.json
!/models/*_metrics.json
!/models/run_id.txt
# Pointeurs DVC du modèle final (model.onnx.dvc, convnext-focal.pt.dvc)
!/models/*.dvc
!/models/.gitignore
mlruns/
mlflow_data/
mlflow.db

# Exports d'entraînement (archives de runs, 200-280 Mo) : trop lourds pour Git
# (limite GitHub : 100 Mo/fichier). On garde les petits fichiers (png, csv).
/exports/*.zip

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
pytest-*.xml

# Node
frontend/node_modules/
frontend/dist/
frontend/public/samples/*.jpg

# Divers
.env
.DS_Store
.idea/
.vscode/
*.log
rapport/*.aux
rapport/*.log
rapport/*.out
rapport/*.toc
